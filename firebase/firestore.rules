rules_version = '2';

// Each signed-in person can read and write only their own data:
//   users/{uid}/docs, words, annotations, bookmarks, settings
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && collection in ['docs', 'words', 'annotations', 'bookmarks', 'settings'];
    }
  }
}

{
  "name": "Luma Reader",
  "short_name": "Luma",
  "description": "A calm reader for PDFs, EPUB books and web articles — natural read-aloud with character voices, instant definitions, highlights and notes that sync between your phone and laptop.",
  "id": "./",
  "start_url": "./#/library",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#F5F6F8",
  "theme_color": "#1E2A3A",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "text/plain": [
          ".txt"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "application/epub+zip",
            ".epub",
            "text/plain",
            ".txt",
            "text/markdown",
            ".md",
            "text/html",
            ".html"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Words",
      "url": "./#/words",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Notes",
      "url": "./#/notes",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}